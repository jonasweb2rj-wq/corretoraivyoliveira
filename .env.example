# GEMINI_API_KEY: Required for server-side Gemini AI multimodal analysis and copywriting.
# AI Studio automatically injects this at runtime from user secrets; set it in Vercel Environment Variables if using AI features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BLOB_STORE_ID & BLOB_READ_WRITE_TOKEN: Required on Vercel for permanent photo & video uploads (Storage > Blob).
# When omitted in AI Studio preview, uploads use isolated local preview storage.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
